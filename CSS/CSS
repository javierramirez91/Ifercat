:root {
            --primary-color: #00508C;
            --secondary-color: #007BFF;
            --accent-color: #28a745;
            --danger-color: #dc3545;
            --text-color: #1f2937;
            --light-text-color: #6c757d;
            --bg-color: #f8f9fa;
            --container-bg: #ffffff;
            --border-color: #dee2e6;
            --header-gradient: linear-gradient(135deg, #00508C 0%, #003359 100%);
            --collapsible-bg: #eef7ff;
            --collapsible-hover-bg: #d9eaff;
            --collapsible-active-bg: var(--primary-color);
            --collapsible-active-text: #ffffff;
            --collapsible-border: #cce0ff;
            --code-bg: #2b2b2b;
            --code-text: #f8f8f2;
            --important-note-bg: #fff3cd;
            --important-note-border: #ffeeba;
            --important-note-text: #856404;
            --example-box-bg: #f0f8ff;
            --example-box-border: #b0c4de;
            --footer-bg: #212529;
            --footer-text: #f8f9fa;
            --font-sans: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
            --font-mono: 'Fira Code', 'Consolas', 'Monaco', 'Courier New', monospace;
            --border-radius-sm: 4px;
            --border-radius-md: 8px;
            --border-radius-lg: 12px;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        }
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: var(--font-sans); line-height: 1.7; margin: 0; padding: 0; background-color: var(--bg-color); color: var(--text-color); font-size: 16.5px; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
        .main-wrapper { padding: 20px; padding-bottom: 100px; } /* Espai per al FAB del xat */
        .container { max-width: 1200px; margin: 20px auto; background: var(--container-bg); padding: 30px 35px; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); }
        header { background: var(--header-gradient); color: white; padding: 35px 25px; text-align: center; margin-bottom: 35px; border-radius: var(--border-radius-md); box-shadow: var(--shadow-lg); }
        header h1 { margin: 0; font-size: clamp(2.2em, 5vw, 2.9em); font-weight: 700; letter-spacing: -0.02em; }
        header p { margin-top: 10px; font-size: clamp(1.05em, 2.5vw, 1.2em); opacity: 0.95; }
        .toc { background-color: #fdfdff; border: 1px solid var(--border-color); padding: 25px; margin-bottom: 35px; border-radius: var(--border-radius-md); box-shadow: var(--shadow-sm); }
        .toc h2 { margin-top: 0; color: var(--primary-color); font-size: 1.5em; border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; }
        .toc ul { list-style-type: none; padding-left: 0; }
        .toc ul li { margin-bottom: 10px; }
        .toc ul li a { text-decoration: none; color: var(--primary-color); font-weight: 500; transition: color 0.2s ease; font-size: 1.05em;}
        .toc ul li a:hover { color: var(--secondary-color); text-decoration: underline; }
        .toc ul ul { margin-left: 20px; margin-top: 8px; } 
        .toc ul ul li a { font-weight: normal; color: #4a5568; font-size: 1em;} 
        .toc ul ul li a:hover { color: var(--text-color); }
        .toc ul ul ul { margin-left: 20px; margin-top: 6px; }
        .toc ul ul ul li a { font-size: 0.95em; color: var(--light-text-color); }
        section { margin-bottom: 45px; }
        h2 { color: var(--primary-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 15px; margin-top: 45px; font-size: 2.1em; font-weight: 600; }
        h3 { color: var(--secondary-color); margin-top: 35px; font-size: 1.75em; font-weight: 600; border-left: 4px solid var(--secondary-color); padding-left: 12px; margin-bottom: 25px; }
        h4 { color: #008080; margin-top: 30px; font-size: 1.45em; font-weight: 600; } 
        h4::before { content: ''; margin-right: 0px; }
        h5 { color: #495057; margin-top: 25px; font-size: 1.2em; font-style: normal; font-weight: 600; border-bottom: 1px dashed #ced4da; padding-bottom: 8px; margin-bottom:15px;}
        h6 { color: var(--light-text-color); margin-top:20px; font-size:1.05em; font-weight:bold; text-transform: uppercase; letter-spacing: 0.5px;}
        .collapsible { background-color: var(--collapsible-bg); color: var(--primary-color); cursor: pointer; padding: 16px 22px; width: 100%; border: 1px solid var(--collapsible-border); text-align: left; outline: none; font-size: 1.2em; margin-top: 15px; border-radius: var(--border-radius-md); font-weight: 500; display: flex; justify-content: space-between; align-items: center; transition: background-color 0.2s ease, color 0.2s ease; }
        .collapsible:hover { background-color: var(--collapsible-hover-bg); }
        .collapsible.active { background-color: var(--collapsible-active-bg); color: var(--collapsible-active-text); border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
        .collapsible-icon { font-weight: bold; transition: transform 0.3s ease-out; font-size: 1.25em; line-height: 1; }
        .collapsible.active .collapsible-icon { transform: rotate(135deg); }
        .content { padding: 0px 22px; max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out, padding-top 0.35s ease-out, padding-bottom 0.35s ease-out; background-color: var(--container-bg); border: 1px solid var(--collapsible-border); border-top: none; border-radius: 0 0 var(--border-radius-md) var(--border-radius-md); }
        .content.open { padding: 20px 22px; }
        ul, ol { padding-left: 22px; } 
        ul.no-bullet { list-style-type: none; padding-left: 0;}
        .list-icon li { list-style-type: none; padding-left: 30px; position: relative; margin-bottom: 10px; }
        .list-icon li::before { position: absolute; left:0; top: 1px; font-size: 1.1em; }
        .list-icon.legal li::before { content: '⚖️'; } .list-icon.doc li::before { content: '📄'; }
        .list-icon.check li::before { content: '✅'; } .list-icon.quality li::before { content: '🌟'; }
        .list-icon.design li::before { content: '🎨'; } .list-icon.access li::before { content: '♿'; }
        .list-icon.idea li::before { content: '💡'; } .list-icon.social li::before { content: '🧑‍🤝‍🧑'; }
        .list-icon.plant li::before { content: '🌿'; } .list-icon.team li::before { content: '👥'; }
        .list-icon.tool li::before { content: '🛠️'; } .list-icon.time li::before { content: '⏳'; }
        li { margin-bottom: 10px; }
        table { width: 100%; border-collapse: separate; border-spacing: 0; margin: 25px 0; box-shadow: var(--shadow-sm); border-radius: var(--border-radius-md); overflow: hidden; }
        th, td { border-bottom: 1px solid var(--border-color); padding: 12px 16px; text-align: left; }
        th { background-color: var(--secondary-color); color: white; font-weight: 600; font-size: 1.02em; }
        td { background-color: var(--container-bg); font-size: 0.97em;}
        tr:last-child td { border-bottom: none; }
        tr:hover td { background-color: #eef7ff; }
        .code-block { background-color: var(--code-bg); color: var(--code-text); padding: 16px; border-radius: var(--border-radius-md); overflow-x: auto; font-family: var(--font-mono); margin: 18px 0; font-size: 0.92em; border: 1px solid #3e4451; }
        .code-block .highlight { color: #98c379; } .code-block .legal-ref-code { color: #61afef; } 
        .code-block .operator { color: #c678dd; } .code-block .number { color: #d19a66; } .code-block .comment { color: #5c6370; font-style: italic; }
        .important-note { background-color: var(--important-note-bg); border-left: 5px solid var(--important-note-border); padding: 16px 20px; margin: 20px 0; border-radius: var(--border-radius-sm); color: var(--important-note-text); font-size: 0.98em;}
        .important-note strong { color: #795c03; }
        .jurisprudencia-ref { font-style: italic; color: var(--light-text-color); display: block; margin-top: 5px; font-size: 0.92em; }
        .legal-ref { font-weight: 600; color: var(--primary-color); }
        .example-box { border: 1px solid var(--example-box-border); padding: 20px; margin-top: 20px; border-radius: var(--border-radius-md); background-color: var(--example-box-bg); box-shadow: var(--shadow-sm); }
        .example-box h5 { color: #004085; margin-top: 0; font-size: 1.2em; font-style: normal; border-bottom: 1px solid #b8daff; padding-bottom:10px; margin-bottom: 15px;}
        .ocr-text-block { background-color: #f0f4f8; border-left: 5px solid var(--secondary-color); padding: 15px 20px; margin: 20px 0; border-radius: var(--border-radius-sm); font-size: 0.95em; }
        .ocr-text-block h4, .ocr-text-block h5 { color: var(--primary-color); margin-top: 0; }
        footer { text-align: center; margin-top: 50px; padding: 30px 20px; background-color: var(--footer-bg); color: var(--footer-text); border-radius: var(--border-radius-md); font-size: 0.95em; }
        #chat-fab { position: fixed; bottom: 25px; right: 25px; background-color: var(--primary-color); color: white; width: 60px; height: 60px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 28px; cursor: pointer; box-shadow: var(--shadow-lg); z-index: 1000; transition: transform 0.2s ease-in-out, background-color 0.2s ease-in-out; }
        #chat-fab:hover { transform: scale(1.1); background-color: var(--secondary-color); }
        #chat-widget { position: fixed; bottom: 100px; right: 25px; width: 370px; max-width: 90vw; height: 70vh; max-height: 550px; background-color: var(--container-bg); border-radius: var(--border-radius-lg); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; overflow: hidden; z-index: 999; transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out; opacity: 0; transform: translateY(20px) scale(0.95); pointer-events: none; }
        #chat-widget.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
        .chat-header { background-color: var(--primary-color); color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; border-top-left-radius: var(--border-radius-lg); border-top-right-radius: var(--border-radius-lg); }
        .chat-header h5 { margin: 0; font-size: 1.15em; color: white; border-bottom: none; font-weight: 500; }
        .chat-close-btn { background: none; border: none; color: white; font-size: 22px; cursor: pointer; opacity: 0.8; transition: opacity 0.2s ease;}
        .chat-close-btn:hover { opacity: 1;}
        .chat-messages { flex-grow: 1; padding: 15px; overflow-y: auto; background-color: #f4f7f9; display: flex; flex-direction: column; gap: 10px; }
        .chat-message { max-width: 85%; padding: 10px 15px; border-radius: var(--border-radius-md); line-height: 1.5; font-size: 0.95em; word-wrap: break-word; }
        .chat-message.user { background-color: var(--secondary-color); color: white; align-self: flex-end; margin-left: auto; border-bottom-right-radius: var(--border-radius-sm); }
        .chat-message.bot { background-color: #e9ecef; color: var(--text-color); align-self: flex-start; margin-right: auto; border-bottom-left-radius: var(--border-radius-sm); }
        .chat-message.loading { align-self: flex-start; color: var(--light-text-color); }
        .chat-message.loading span { display: inline-block; width: 8px; height: 8px; margin: 0 2px; background-color: var(--light-text-color); border-radius: 50%; animation: chatLoading 1.4s infinite ease-in-out both; }
        .chat-message.loading span:nth-child(1) { animation-delay: -0.32s; }
        .chat-message.loading span:nth-child(2) { animation-delay: -0.16s; }
        @keyframes chatLoading { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1.0); } }
        .chat-input-area { display: flex; padding: 15px; border-top: 1px solid var(--border-color); background-color: var(--container-bg); }
        #chat-input { flex-grow: 1; border: 1px solid var(--border-color); border-radius: var(--border-radius-sm); padding: 10px 12px; font-size: 1em; margin-right: 10px; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
        #chat-input:focus { border-color: var(--secondary-color); box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25); outline: none;}
        #chat-send-btn { background-color: var(--primary-color); color: white; border: none; padding: 10px 18px; border-radius: var(--border-radius-sm); cursor: pointer; font-size: 1em; font-weight: 500; transition: background-color 0.2s ease; }
        #chat-send-btn:hover { background-color: var(--secondary-color); }